# Railway / Production environment template
# Copy this file to .env and fill in the real values.

# Spring profile (dev, prod)
SPRING_PROFILES_ACTIVE=prod

# Database connection (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=taskinator
DB_USERNAME=postgres.<username>
DB_PASSWORD=<dbpassword>
DB_SCHEMA=taskinator
DB_APP_ROLE=postgres
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1

# Flyway credentials (usually same as DB)
FLYWAY_USERNAME=postgres.<username>
FLYWAY_PASSWORD=<dbpassword>

# JWT signing secret (must be at least 32 bytes / 256 bits)
JWT_SECRET=<jwtsecret>

# Allowed CORS origins for the frontend (no trailing slash; CORS origin matching is exact)
APP_CORS_ALLOWED_ORIGINS=https://taskinator-client.vercel.app

# Docker compose ports (local development only)
DB_PORT=5432
BACKEND_PORT=8080
DB_NAME=taskinator
